NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
APP_ORIGIN=http://localhost:3000

# Private member resources use the local ignored filesystem in development.
# Production must set supabase-storage and supply a server-only secret key.
PRIVATE_RESOURCE_PROVIDER=filesystem
PRIVATE_RESOURCE_LOCAL_ROOT=
PRIVATE_RESOURCE_BUCKET=member-resources
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_ACQUISITION_TRACKING_ENABLED=false
# Canonical production origin. Leave empty for local and preview environments.
SITE_URL=
# GA4 web stream, enabled only in production and on public marketing pages.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server only. Use local/test values in ignored .env.local; never commit secrets.
SUPABASE_SERVICE_ROLE_KEY=
# Must match server credentials and database policy: test locally, live in production.
STRIPE_BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INCOMENOW_MEMBERSHIP_PRODUCT_ID=
STRIPE_INCOMENOW_MEMBERSHIP_PRICE_ID=
# Same-mode portal: cancel at period end; disable subscription price/quantity changes.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Bearer secret for /api/billing/reconcile. Configure a scheduled caller separately.
BILLING_RECONCILIATION_SECRET=
