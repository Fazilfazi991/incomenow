NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
APP_ORIGIN=http://localhost:3000

# Private member resources use the local ignored filesystem in development.
# Production must set supabase-storage and supply a server-only secret key.
PRIVATE_RESOURCE_PROVIDER=filesystem
PRIVATE_RESOURCE_LOCAL_ROOT=
PRIVATE_RESOURCE_BUCKET=member-resources
SUPABASE_SECRET_KEY=
